@model MasterDashboardViewModel
@{
    ViewData["Title"] = "Общий вид мастера-приемщика | Fit Service CRM";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Разделы мастера-приемщика</p>
        <h1>Общий вид</h1>
    </div>
    <div class="quick-stats">
        <div><strong>@Model.RecentOrders.Count</strong><span>заказ-нарядов</span></div>
        <div><strong>@Model.Diagnostics.Count</strong><span>диагностик</span></div>
        <div><strong>@Model.Customers.Count</strong><span>клиентов</span></div>
        <div><strong>@Model.Services.Count</strong><span>услуг</span></div>
    </div>
</section>

<section class="overview-grid">
    <article class="panel">
        <div class="panel-title">
            <div><h2>Заказ-наряды</h2><span>Последние изменения</span></div>
            <a class="button button-small" asp-action="Orders">Смотреть всё</a>
        </div>
        <div class="stack-list">
            @if (Model.RecentOrders.Count == 0)
            {
                <p class="empty-inline">Заказ-наряды пока не найдены.</p>
            }
            @foreach (var order in Model.RecentOrders)
            {
                <article class="list-row">
                    <a class="stretch-link" asp-action="Orders" asp-route-id="@order.Id"></a>
                    <div>
                        <strong>@order.OrderNumber</strong>
                        <span>@order.Customer?.Name · @order.PlannedStartAt.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    <span class="@order.Status.BadgeClass()">@order.Status.Label()</span>
                </article>
            }
        </div>
    </article>

    <article class="panel">
        <div class="panel-title">
            <div><h2>Диагностика</h2><span>Последние заключения</span></div>
            <a class="button button-small" asp-action="Diagnostics">Смотреть всё</a>
        </div>
        <div class="stack-list">
            @if (Model.Diagnostics.Count == 0)
            {
                <p class="empty-inline">Диагностические заключения пока не введены.</p>
            }
            @foreach (var diagnostic in Model.Diagnostics)
            {
                <article class="list-row">
                    <a class="stretch-link" asp-action="Diagnostics" asp-route-id="@diagnostic.Id"></a>
                    <div>
                        <strong>@diagnostic.Vehicle?.PlateNumber</strong>
                        <span>@diagnostic.CreatedAt.ToString("dd.MM.yyyy HH:mm") · @diagnostic.Customer?.Name</span>
                    </div>
                    <span class="@diagnostic.Status.BadgeClass()">@diagnostic.Status.Label()</span>
                </article>
            }
        </div>
    </article>

    <article class="panel">
        <div class="panel-title">
            <div><h2>Клиенты</h2><span>Карточки клиентов</span></div>
            <a class="button button-small" asp-action="Customers">Смотреть всё</a>
        </div>
        <div class="stack-list">
            @if (Model.Customers.Count == 0)
            {
                <p class="empty-inline">Клиенты пока не найдены.</p>
            }
            @foreach (var customer in Model.Customers)
            {
                <article class="list-row">
                    <a class="stretch-link" asp-action="Customers" asp-route-id="@customer.Id"></a>
                    <div>
                        <strong>@customer.Name</strong>
                        <span>@customer.Type.Label() · @customer.Phone</span>
                    </div>
                </article>
            }
        </div>
    </article>

    <article class="panel">
        <div class="panel-title">
            <div><h2>Услуги</h2><span>Доступные услуги</span></div>
            <a class="button button-small" asp-action="Services">Смотреть всё</a>
        </div>
        <div class="stack-list">
            @if (Model.Services.Count == 0)
            {
                <p class="empty-inline">Услуги пока не загружены.</p>
            }
            @foreach (var service in Model.Services)
            {
                <article class="list-row">
                    <a class="stretch-link" asp-action="Services" asp-route-id="@service.Id"></a>
                    <div>
                        <strong>@service.Name</strong>
                        <span>@service.Category · @service.BasePrice.Money()</span>
                    </div>
                </article>
            }
        </div>
    </article>
</section>
