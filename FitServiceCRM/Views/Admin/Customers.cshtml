@model AdminCustomersSectionViewModel
@{
    ViewData["Title"] = "Раздел: Клиенты | Fit Service CRM";
    var selected = Model.SelectedCustomer ?? new Customer { Type = CustomerType.Individual, Status = CustomerStatus.Active };
    var individual = selected.IndividualProfile ?? new IndividualCustomer();
    var legal = selected.LegalProfile ?? new LegalCustomer();
    var representativeMode = Model.ShowRepresentativeCard;
    var vehicleMode = Model.ShowVehicleCard;
    var editMode = Model.IsEdit;
    var selectedVehicle = Model.SelectedVehicle ?? new Vehicle
    {
        CustomerId = selected.Id,
        Year = DateTime.Today.Year
    };
    var selectedRepresentative = Model.SelectedRepresentative ?? new CustomerRepresentative
    {
        CustomerId = selected.Id
    };
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Раздел</p>
        <h1>Клиенты</h1>
    </div>
    <a class="button" asp-action="Index">Общий вид</a>
</section>

<section class="admin-section @((vehicleMode || representativeMode) ? "with-card customer-vehicle-mode" : Model.ShowCard ? "with-card" : "list-only")">
    @if (!vehicleMode && !representativeMode)
    {
        <div class="panel">
            <div class="panel-title">
                <div>
                    <h2>Список клиентов</h2>
                    <span>Поиск по ФИО, названию, представителю или ТС</span>
                </div>
                <a class="button button-primary button-small" asp-action="Customers" asp-route-create="true">Создать</a>
            </div>
            <form method="get" class="filter-bar">
                <input name="q" value="@Model.Query" placeholder="Клиент, телефон, VIN, гос. номер" />
                <select name="type">
                    <option value="">Все типы</option>
                    <option value="@CustomerType.Individual" selected="@(Model.Type == CustomerType.Individual)">Физическое лицо</option>
                    <option value="@CustomerType.Company" selected="@(Model.Type == CustomerType.Company)">Юридическое лицо</option>
                </select>
                <select name="status">
                    <option value="">Все статусы</option>
                    @foreach (var status in Enum.GetValues<CustomerStatus>())
                    {
                        <option value="@status" selected="@(Model.Status == status)">@status.Label()</option>
                    }
                </select>
                <select name="sort">
                    <option value="name" selected="@(Model.Sort == "name")">Имя А-Я</option>
                    <option value="name_desc" selected="@(Model.Sort == "name_desc")">Имя Я-А</option>
                    <option value="phone" selected="@(Model.Sort == "phone")">Телефон А-Я</option>
                    <option value="phone_desc" selected="@(Model.Sort == "phone_desc")">Телефон Я-А</option>
                    <option value="type" selected="@(Model.Sort == "type")">Тип А-Я</option>
                    <option value="type_desc" selected="@(Model.Sort == "type_desc")">Тип Я-А</option>
                    <option value="status" selected="@(Model.Sort == "status")">Статус А-Я</option>
                    <option value="status_desc" selected="@(Model.Sort == "status_desc")">Статус Я-А</option>
                </select>
                <button class="button" type="submit">Применить</button>
            </form>
            <div class="section-list">
                @foreach (var customer in Model.Customers)
                {
                    <a class="section-list-row @(Model.SelectedCustomer?.Id == customer.Id ? "active" : "")"
                       asp-action="Customers"
                       asp-route-id="@customer.Id"
                       asp-route-q="@Model.Query"
                       asp-route-sort="@Model.Sort"
                       asp-route-type="@Model.Type"
                       asp-route-status="@Model.Status">
                        <span>
                            <strong>@customer.Name</strong>
                            <small>@customer.Type.Label() · @customer.Status.Label() · @customer.Vehicles.Count ТС · @customer.Phone</small>
                        </span>
                    </a>
                }
            </div>
        </div>
    }

    @if (Model.ShowCard)
    {
        <aside class="panel object-card">
            <div class="panel-title">
                <div>
                    <h2>@(Model.IsCreate ? "Новый клиент" : selected.Name)</h2>
                    <span>@(editMode ? "Режим изменения" : "Режим просмотра")</span>
                </div>
                <div class="actions-row">
                    @if (vehicleMode || representativeMode)
                    {
                        <a class="button button-small" asp-action="Customers" asp-route-id="@selected.Id" asp-route-edit="true">К клиенту</a>
                    }
                    @if (!editMode && !Model.IsCreate)
                    {
                        <a class="button button-small" asp-action="Customers" asp-route-id="@selected.Id" asp-route-edit="true">Редактировать</a>
                    }
                </div>
            </div>
            <form asp-action="SaveCustomer" method="post" class="form-grid compact">
                @Html.AntiForgeryToken()
                @if (!Model.IsCreate)
                {
                    <input type="hidden" name="id" value="@selected.Id" />
                }
                <fieldset disabled="@(!editMode)">
                    <label>
                        <span>Тип клиента</span>
                        <select name="type">
                            <option value="@CustomerType.Individual" selected="@(selected.Type == CustomerType.Individual)">Физическое лицо</option>
                            <option value="@CustomerType.Company" selected="@(selected.Type == CustomerType.Company)">Юридическое лицо</option>
                        </select>
                    </label>
                    <label>
                        <span>Статус</span>
                        <select name="status">
                            @foreach (var status in Enum.GetValues<CustomerStatus>())
                            {
                                <option value="@status" selected="@(selected.Status == status)">@status.Label()</option>
                            }
                        </select>
                    </label>

                    <div class="form-divider wide">Физическое лицо</div>
                    <label class="wide"><span>ФИО</span><input name="individualFullName" value="@individual.FullName" /></label>
                    <label><span>Дата рождения</span><input name="birthDate" type="date" value="@individual.BirthDate?.ToString("yyyy-MM-dd")" /></label>
                    <label><span>Телефон</span><input name="individualPhone" value="@individual.Phone" /></label>
                    <label><span>Email</span><input name="individualEmail" type="email" value="@individual.Email" /></label>

                    <div class="form-divider wide">Юридическое лицо</div>
                    <label class="wide"><span>Наименование организации</span><input name="organizationName" value="@legal.OrganizationName" /></label>
                    <label><span>ИНН</span><input name="inn" maxlength="12" value="@legal.Inn" /></label>
                    <label><span>КПП</span><input name="kpp" maxlength="9" value="@legal.Kpp" /></label>
                    <label><span>ОГРН / ОГРНИП</span><input name="ogrn" maxlength="15" value="@legal.Ogrn" /></label>
                    <label class="wide"><span>Юридический адрес</span><input name="legalAddress" value="@legal.LegalAddress" /></label>
                    <label class="wide"><span>Фактический адрес</span><input name="actualAddress" value="@legal.ActualAddress" /></label>
                    <label><span>Телефон организации</span><input name="organizationPhone" value="@legal.Phone" /></label>
                    <label><span>Email организации</span><input name="organizationEmail" type="email" value="@legal.Email" /></label>
                    <label class="wide"><span>Комментарий</span><textarea name="comment" rows="3">@selected.Comment</textarea></label>
                </fieldset>
                @if (editMode)
                {
                    <button class="button button-primary" type="submit">Сохранить клиента</button>
                }
            </form>

            @if (!Model.IsCreate)
            {
                @if (selected.Type == CustomerType.Company)
                {
                    <div class="subsection vehicles-subsection">
                        <div class="section-subtitle">
                            <h3>Представители</h3>
                            @if (editMode)
                            {
                                <a class="button button-small" asp-action="Customers" asp-route-id="@selected.Id" asp-route-edit="true" asp-route-representativeCreate="true">Добавить представителя</a>
                            }
                        </div>
                        @if (selected.Representatives.Count == 0)
                        {
                            <p class="empty-inline">Представители пока не добавлены.</p>
                        }
                        @foreach (var representative in selected.Representatives)
                        {
                            <div class="mini-row vehicle-row">
                                <span>@representative.FullName</span>
                                <strong>@(string.IsNullOrWhiteSpace(representative.Position) ? "Без должности" : representative.Position)</strong>
                                @if (editMode)
                                {
                                    <a class="button button-small" asp-action="Customers" asp-route-id="@selected.Id" asp-route-edit="true" asp-route-representativeId="@representative.Id" asp-route-representativeEdit="true">Карточка</a>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="subsection vehicles-subsection">
                    <div class="section-subtitle">
                        <h3>Автомобили клиента</h3>
                        @if (editMode)
                        {
                            <a class="button button-small" asp-action="Customers" asp-route-id="@selected.Id" asp-route-edit="true" asp-route-vehicleCreate="true">Добавить автомобиль</a>
                        }
                    </div>
                    @if (selected.Vehicles.Count == 0)
                    {
                        <p class="empty-inline">Автомобили пока не добавлены.</p>
                    }
                    @foreach (var vehicle in selected.Vehicles)
                    {
                        <div class="mini-row vehicle-row">
                            <span>@vehicle.PlateNumber · @vehicle.Make @vehicle.Model</span>
                            <strong>@vehicle.Year · @vehicle.Mileage км</strong>
                            @if (editMode)
                            {
                                <a class="button button-small" asp-action="Customers" asp-route-id="@selected.Id" asp-route-edit="true" asp-route-vehicleId="@vehicle.Id" asp-route-vehicleEdit="true">Карточка</a>
                            }
                        </div>
                    }
                </div>
            }
        </aside>
    }

    @if (representativeMode)
    {
        <aside class="panel object-card vehicle-card">
            <div class="panel-title">
                <div>
                    <h2>@(Model.IsRepresentativeCreate ? "Новый представитель" : selectedRepresentative.FullName)</h2>
                    <span>Карточка представителя</span>
                </div>
                <a class="button button-small" asp-action="Customers" asp-route-id="@selected.Id" asp-route-edit="true">Закрыть</a>
            </div>

            <form asp-action="SaveRepresentative" method="post" class="form-grid compact">
                @Html.AntiForgeryToken()
                <input type="hidden" name="customerId" value="@selected.Id" />
                @if (!Model.IsRepresentativeCreate)
                {
                    <input type="hidden" name="id" value="@selectedRepresentative.Id" />
                }
                <fieldset>
                    <label class="wide"><span>ФИО представителя</span><input name="fullName" value="@selectedRepresentative.FullName" required /></label>
                    <label><span>Должность</span><input name="position" value="@selectedRepresentative.Position" /></label>
                    <label><span>Телефон</span><input name="phone" value="@selectedRepresentative.Phone" /></label>
                    <label><span>Email</span><input name="email" type="email" value="@selectedRepresentative.Email" /></label>
                </fieldset>
                <button class="button button-primary" type="submit">Сохранить представителя</button>
            </form>

            @if (!Model.IsRepresentativeCreate)
            {
                <form asp-action="DeleteRepresentative" method="post" class="danger-zone">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@selectedRepresentative.Id" />
                    <input type="hidden" name="customerId" value="@selected.Id" />
                    <button class="button button-danger" type="submit">Удалить представителя</button>
                </form>
            }
        </aside>
    }
    else if (vehicleMode)
    {
        <aside class="panel object-card vehicle-card">
            <div class="panel-title">
                <div>
                    <h2>@(Model.IsVehicleCreate ? "Новый автомобиль" : $"{selectedVehicle.Make} {selectedVehicle.Model}")</h2>
                    <span>Карточка транспортного средства</span>
                </div>
                <a class="button button-small" asp-action="Customers" asp-route-id="@selected.Id" asp-route-edit="true">Закрыть</a>
            </div>

            <form asp-action="SaveVehicle" method="post" class="form-grid compact">
                @Html.AntiForgeryToken()
                <input type="hidden" name="customerId" value="@selected.Id" />
                @if (!Model.IsVehicleCreate)
                {
                    <input type="hidden" name="id" value="@selectedVehicle.Id" />
                }
                <fieldset>
                    <label><span>VIN</span><input name="vin" maxlength="17" value="@selectedVehicle.Vin" /></label>
                    <label><span>Гос. номер</span><input name="plateNumber" value="@selectedVehicle.PlateNumber" required /></label>
                    <label><span>Марка</span><input name="make" value="@selectedVehicle.Make" required /></label>
                    <label><span>Модель</span><input name="model" value="@selectedVehicle.Model" required /></label>
                    <label><span>Год выпуска</span><input name="year" type="number" min="1980" max="2100" value="@selectedVehicle.Year" required /></label>
                    <label><span>Пробег, км</span><input name="mileage" type="number" min="0" value="@selectedVehicle.Mileage" required /></label>
                    <label><span>Цвет</span><input name="color" value="@selectedVehicle.Color" /></label>
                </fieldset>
                <button class="button button-primary" type="submit">Сохранить автомобиль</button>
            </form>

            @if (!Model.IsVehicleCreate)
            {
                <form asp-action="DeleteVehicle" method="post" class="danger-zone">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@selectedVehicle.Id" />
                    <input type="hidden" name="customerId" value="@selected.Id" />
                    <button class="button button-danger" type="submit">Удалить автомобиль</button>
                </form>
            }
        </aside>
    }
</section>
