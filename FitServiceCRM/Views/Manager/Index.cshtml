@model ManagerDashboardViewModel
@{
    ViewData["Title"] = "Общий вид руководителя сервиса | Fit Service CRM";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Разделы руководителя сервиса</p>
        <h1>Общий вид</h1>
    </div>
    <div class="quick-stats">
        <div><strong>@Model.RecentOrders.Count</strong><span>последних заказ-нарядов</span></div>
        <div><strong>@Model.Customers.Count</strong><span>клиентов</span></div>
        <div><strong>@Model.Services.Count</strong><span>услуг</span></div>
        <div><strong>@Model.Employees.Count</strong><span>сотрудников</span></div>
    </div>
</section>

<section class="overview-grid">
    <article class="panel">
        <div class="panel-title">
            <div>
                <h2>Заказ-наряды</h2>
                <span>Последние изменения</span>
            </div>
            <a class="button button-small" asp-action="Orders">Смотреть всё</a>
        </div>
        <div class="stack-list">
            @if (Model.RecentOrders.Count == 0)
            {
                <p class="empty-inline">Пока нет заказ-нарядов, доступных для обзора.</p>
            }
            @foreach (var order in Model.RecentOrders)
            {
                var updated = order.StatusHistory.OrderByDescending(item => item.ChangedAt).FirstOrDefault();
                <article class="list-row">
                    <a class="stretch-link" asp-action="Orders" asp-route-id="@order.Id"></a>
                    <div>
                        <strong>@order.OrderNumber</strong>
                        <span>@order.PlannedStartAt.ToString("dd.MM.yyyy") · @order.Customer?.Name</span>
                        <span class="@order.Status.BadgeClass()">@order.Status.Label()</span>
                    </div>
                    <div class="actions-row">
                        @if (updated is not null && updated.ChangedAt >= DateTime.Now.AddDays(-3))
                        {
                            <span class="mini-badge">Обновлено</span>
                        }
                        <a class="button button-small" asp-action="Orders" asp-route-id="@order.Id" asp-route-history="true">История</a>
                    </div>
                </article>
            }
        </div>
    </article>

    <article class="panel">
        <div class="panel-title">
            <div>
                <h2>Клиенты</h2>
                <span>Карточки клиентов</span>
            </div>
            <a class="button button-small" asp-action="Customers">Смотреть всё</a>
        </div>
        <div class="stack-list">
            @if (Model.Customers.Count == 0)
            {
                <p class="empty-inline">Клиенты пока не найдены.</p>
            }
            @foreach (var customer in Model.Customers)
            {
                <article class="list-row">
                    <a class="stretch-link" asp-action="Customers" asp-route-id="@customer.Id"></a>
                    <div>
                        <strong>@customer.Name</strong>
                        <span>@customer.Type.Label() · @customer.Phone</span>
                    </div>
                    <a class="button button-small" asp-action="Customers" asp-route-id="@customer.Id">Карточка</a>
                </article>
            }
        </div>
    </article>

    <article class="panel">
        <div class="panel-title">
            <div>
                <h2>Услуги</h2>
                <span>Каталог работ</span>
            </div>
            <a class="button button-small" asp-action="Services">Смотреть всё</a>
        </div>
        <div class="stack-list">
            @if (Model.Services.Count == 0)
            {
                <p class="empty-inline">Услуги пока не добавлены.</p>
            }
            @foreach (var service in Model.Services)
            {
                <article class="list-row">
                    <a class="stretch-link" asp-action="Services" asp-route-id="@service.Id"></a>
                    <div>
                        <strong>@service.Name</strong>
                        <span>@service.Category · @service.BasePrice.Money()</span>
                    </div>
                </article>
            }
        </div>
    </article>

    <article class="panel">
        <div class="panel-title">
            <div>
                <h2>Сотрудники</h2>
                <span>Контакты сервиса</span>
            </div>
            <a class="button button-small" asp-action="Employees">Смотреть всё</a>
        </div>
        <div class="stack-list">
            @if (Model.Employees.Count == 0)
            {
                <p class="empty-inline">Сотрудники пока не найдены.</p>
            }
            @foreach (var employee in Model.Employees)
            {
                <article class="list-row">
                    <a class="stretch-link" asp-action="Employees" asp-route-id="@employee.Id"></a>
                    <div>
                        <strong>@employee.FullName</strong>
                        <span>@employee.Position · @employee.Phone</span>
                    </div>
                </article>
            }
        </div>
    </article>
</section>
