@model ClientDashboardViewModel
@{
    ViewData["Title"] = "Общий вид клиента | Fit Service CRM";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Клиентский раздел</p>
        <h1>Общий вид</h1>
    </div>
    <div class="quick-stats">
        <div><strong>@Model.Vehicles.Count</strong><span>транспортных средств</span></div>
        <div><strong>@Model.Orders.Count</strong><span>заказ-нарядов</span></div>
        <div><strong>@Model.Diagnostics.Count</strong><span>диагностик</span></div>
        <div><strong>@Model.Notifications.Count(item => !item.IsRead)</strong><span>новых уведомлений</span></div>
    </div>
</section>

<section class="overview-grid">
    <article class="panel">
        <div class="panel-title">
            <div><h2>Уведомления</h2><span>Последние важные события</span></div>
        </div>
        <div class="stack-list">
            @if (Model.Notifications.Count == 0)
            {
                <p class="empty-inline">Новых уведомлений пока нет.</p>
            }
            @foreach (var notification in Model.Notifications)
            {
                var targetAction = notification.WorkOrderId is not null ? "Orders" : notification.DiagnosticConclusionId is not null ? "Diagnostics" : "Vehicles";
                <article class="list-row">
                    <a class="stretch-link" asp-action="@targetAction" asp-route-id="@(notification.WorkOrderId ?? notification.DiagnosticConclusionId ?? notification.VehicleId)" asp-route-notificationId="@notification.Id"></a>
                    <div>
                        <strong>@notification.Title</strong>
                        <span>@notification.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                        <span>@notification.Message</span>
                    </div>
                    @if (!notification.IsRead)
                    {
                        <span class="mini-badge">Новое</span>
                    }
                </article>
            }
        </div>
    </article>

    <article class="panel">
        <div class="panel-title"><div><h2>Транспортные средства</h2><span>Ваш парк</span></div><a class="button button-small" asp-action="Vehicles">Смотреть всё</a></div>
        <div class="stack-list">
            @if (Model.Vehicles.Count == 0)
            {
                <p class="empty-inline">Транспортные средства пока не добавлены.</p>
            }
            @foreach (var vehicle in Model.Vehicles)
            {
                <article class="list-row">
                    <a class="stretch-link" asp-action="Vehicles" asp-route-id="@vehicle.Id"></a>
                    <div>
                        <strong>@vehicle.Make @vehicle.Model</strong>
                        <span>@vehicle.PlateNumber · @vehicle.Mileage км</span>
                    </div>
                </article>
            }
        </div>
    </article>

    <article class="panel">
        <div class="panel-title"><div><h2>Заказ-наряды</h2><span>Последние заказы</span></div><a class="button button-small" asp-action="Orders">Смотреть всё</a></div>
        <div class="stack-list">
            @if (Model.Orders.Count == 0)
            {
                <p class="empty-inline">Заказ-наряды пока не найдены.</p>
            }
            @foreach (var order in Model.Orders)
            {
                <article class="list-row">
                    <a class="stretch-link" asp-action="Orders" asp-route-id="@order.Id"></a>
                    <div>
                        <strong>@order.OrderNumber</strong>
                        <span>@order.PlannedStartAt.ToString("dd.MM.yyyy HH:mm") · @order.TotalCost.Money()</span>
                    </div>
                    <span class="@order.Status.BadgeClass()">@order.Status.Label()</span>
                </article>
            }
        </div>
    </article>

    <article class="panel">
        <div class="panel-title"><div><h2>Диагностика</h2><span>Заключения по автомобилям</span></div><a class="button button-small" asp-action="Diagnostics">Смотреть всё</a></div>
        <div class="stack-list">
            @if (Model.Diagnostics.Count == 0)
            {
                <p class="empty-inline">Диагностические заключения пока не сформированы.</p>
            }
            @foreach (var diagnostic in Model.Diagnostics)
            {
                <article class="list-row">
                    <a class="stretch-link" asp-action="Diagnostics" asp-route-id="@diagnostic.Id"></a>
                    <div>
                        <strong>@diagnostic.Vehicle?.PlateNumber</strong>
                        <span>@diagnostic.CreatedAt.ToString("dd.MM.yyyy HH:mm") · @diagnostic.Vehicle?.Make @diagnostic.Vehicle?.Model</span>
                    </div>
                    <span class="@diagnostic.Status.BadgeClass()">@diagnostic.Status.Label()</span>
                </article>
            }
        </div>
    </article>

    <article class="panel span-2">
        <div class="panel-title"><div><h2>Контакты</h2><span>Ответственные сотрудники сервиса</span></div></div>
        <div class="contacts-grid">
            @if (Model.ServiceManager is not null)
            {
                <article class="list-row">
                    <div>
                        <strong>@Model.ServiceManager.FullName</strong>
                        <span>Руководитель сервиса</span>
                        <span>@Model.ServiceManager.Phone · @Model.ServiceManager.Email</span>
                    </div>
                </article>
            }
            @foreach (var contact in Model.Contacts)
            {
                <article class="list-row">
                    <div>
                        <strong>@contact.Employee.FullName</strong>
                        <span>Мастер-приемщик</span>
                        <span>@contact.Employee.Phone · @contact.Employee.Email</span>
                        <span>@contact.Vehicle?.Make @contact.Vehicle?.Model · @contact.Vehicle?.PlateNumber · @contact.WorkOrder?.OrderNumber</span>
                    </div>
                </article>
            }
        </div>
    </article>
</section>
