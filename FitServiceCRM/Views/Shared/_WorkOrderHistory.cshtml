@model List<WorkOrderHistoryEntryViewModel>

@if (Model.Count == 0)
{
    <p class="empty">История пока пуста.</p>
}
else
{
    <div class="event-list">
        @foreach (var item in Model)
        {
            <article class="event-card">
                <div class="event-meta">
                    <strong>@item.EventType</strong>
                    <span>@item.At.ToString("dd.MM.yyyy HH:mm")</span>
                </div>
                <p>@item.Description</p>
                <div class="event-footer">
                    <span>@item.Author</span>
                    @if (!string.IsNullOrWhiteSpace(item.Result))
                    {
                        <span class="badge badge-neutral">@item.Result</span>
                    }
                </div>
            </article>
        }
    </div>
}
