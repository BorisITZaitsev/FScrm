@using System.Security.Claims
@{
    var title = ViewData["Title"] as string ?? "Fit Service CRM";
    var role = User.FindFirstValue(ClaimTypes.Role);
    var displayName = User.FindFirstValue("DisplayName") ?? User.Identity?.Name;
}
<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark">FS</span>
                <span>Fit Service CRM</span>
            </a>
            <nav class="nav">
                @if (role == nameof(UserRole.Admin))
                {
                    <a asp-controller="Admin" asp-action="Index">Общий вид</a>
                    <a asp-controller="Admin" asp-action="Users">Пользователи</a>
                    <a asp-controller="Admin" asp-action="Employees">Сотрудники</a>
                    <a asp-controller="Admin" asp-action="Services">Услуги</a>
                    <a asp-controller="Admin" asp-action="Customers">Клиенты</a>
                    <a asp-controller="Admin" asp-action="Orders">Заказ-наряды</a>
                }
                @if (role == nameof(UserRole.Master))
                {
                    <a asp-controller="Master" asp-action="Index">Приемка</a>
                }
                @if (role == nameof(UserRole.Manager))
                {
                    <a asp-controller="Manager" asp-action="Index">Руководитель</a>
                }
                @if (role == nameof(UserRole.Client))
                {
                    <a asp-controller="ClientPortal" asp-action="Index">Кабинет клиента</a>
                }
            </nav>
            <form class="logout" asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <div>
                    <strong>@displayName</strong>
                    <span>@(Enum.Parse<UserRole>(role ?? nameof(UserRole.Client)).Label())</span>
                </div>
                <button type="submit" class="button button-ghost">Выйти</button>
            </form>
        </aside>
        <main class="content">
            @if (TempData["Message"] is string message)
            {
                <div class="notice">@message</div>
            }
            @RenderBody()
        </main>
    </div>
}
else
{
    <main class="auth-content">
        @RenderBody()
    </main>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
